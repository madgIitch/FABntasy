DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres:[password]@[db-host]:5432/postgres?sslmode=require
FAB_DEVICE_ID=
FAB_KEY=
FAB_CREDENTIALS_FILE=.local/fab-credentials.json
FAB_AUTO_CREDENTIAL_REFRESH=true
FAB_ACTIVE_SEASON=2026/2027
FAB_SCHEDULER_ACTIVE_SECONDS=30
INGESTOR_MODE=mock
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production must be the canonical HTTPS origin from infrastructure/production.json.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CANASTIO_FANTASY_LIFECYCLE_URL=http://localhost:3000/api/internal/fantasy/lifecycle
CANASTIO_INTERNAL_JOB_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Public rotation label. Changing it invalidates old subscriptions and requires opt-in again.
VAPID_KEY_VERSION=v1
CANASTIO_SERVER_CACHE_ENABLED=true
CANASTIO_CACHE_TTL_MS=15000
CANASTIO_PERF_SAMPLES=40
CANASTIO_RELEASE=dev
CANASTIO_ERROR_TRACKING_ENABLED=false
CANASTIO_USAGE_METRICS_ENABLED=false
CANASTIO_FEEDBACK_ENABLED=false
INGESTOR_SHUTDOWN_GRACE_SECONDS=10
# Performance tests require CANASTIO_TEST_DATABASE=1 and TEST_DATABASE_URL.
# Production secrets are injected server-side by provider secret managers; never copy
# DATABASE_URL, DIRECT_URL, service-role, FAB, internal, VAPID or provider secrets here.
# Push outbox: wake credentials are distinct from dispatcher credentials.
CANASTIO_PUSH_WAKE_URL=https://push-worker.example/internal/push/wake
CANASTIO_PUSH_WAKE_SECRET=replace-with-a-dedicated-wake-secret
CANASTIO_PUSH_DISPATCH_URL=https://canastio.example/api/notifications/dispatch
CANASTIO_PUSH_JOB_SECRET=replace-with-a-distinct-dispatch-secret
