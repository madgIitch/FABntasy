    "webDigest": "sha256:SET_BY_RELEASE_WORKFLOW",
    "ingestorDigest": "sha256:SET_BY_RELEASE_WORKFLOW",
    "previousWebDigest": "sha256:SET_BEFORE_PROMOTION",
    "previousIngestorDigest": "sha256:SET_BEFORE_PROMOTION"
