{
  "schemaVersion": "fabntasy.production.v1",
  "release": "1.0.0",
  "canonicalOrigin": "https://fabntasy.es",
  "regions": { "web": "vercel-fra1", "database": "eu-west-1", "ingestor": "europe-west4" },
  "providers": { "dnsAndWeb": "vercel", "databaseAndAuth": "supabase", "ingestor": "railway", "images": "ghcr" },
  "owners": { "release": "product-owner", "web": "web-on-call", "data": "data-on-call", "security": "security-owner" },
  "artifacts": {
