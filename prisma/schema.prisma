generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  authUserId  String   @unique @map("auth_user_id") @db.Uuid
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  fantasyTeams FantasyTeam[]
  ownedFantasyLeagues FantasyLeague[] @relation("FantasyLeagueOwner")
  leagueMemberships LeagueMembership[]

  @@map("user_profiles")
}

model Federation {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  countryCode  String        @default("ES") @map("country_code")
  competitions Competition[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([name, countryCode])
  @@map("federations")
}

model Competition {
  id                 String              @id @default(uuid()) @db.Uuid
  federationId       String              @map("federation_id") @db.Uuid
  name               String
  federation         Federation          @relation(fields: [federationId], references: [id], onDelete: Restrict)
  competitionSeasons CompetitionSeason[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@unique([federationId, name])
  @@map("competitions")
}

model Season {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @unique
  startsOn           DateTime?           @map("starts_on") @db.Date
  endsOn             DateTime?           @map("ends_on") @db.Date
  competitionSeasons CompetitionSeason[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("seasons")
}

model CompetitionSeason {
  id                   String                     @id @default(uuid()) @db.Uuid
  competitionId        String                     @map("competition_id") @db.Uuid
  seasonId             String                     @map("season_id") @db.Uuid
  name                 String?
  fantasyEnabled       Boolean                    @default(false) @map("fantasy_enabled")
  fantasyRole          String                     @default("disabled") @map("fantasy_role")
  categoryName         String?                    @map("category_name")
  delegationName       String?                    @map("delegation_name")
  competition          Competition                @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  season               Season                     @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  groups               Group[]
  teamRegistrations    TeamRegistration[]
  playerRegistrations  PlayerRegistration[]
  games                Game[]
  ingestionRuns        IngestionRun[]
  fantasyRuleSets      FantasyScoringRuleSet[]
  fantasyRuleSetEvents FantasyRuleSetActivation[]
  fantasyRosterRuleSets FantasyRosterRuleSet[]
  fantasyTeams          FantasyTeam[]
  playerPrices          PlayerPrice[]
  playerPriceEvents     PlayerPriceEvent[]
  fantasyLeagues        FantasyLeague[]
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  @@unique([competitionId, seasonId])
  @@map("competition_seasons")
}

model Group {
  id                  String             @id @default(uuid()) @db.Uuid
  competitionSeasonId String             @map("competition_season_id") @db.Uuid
  name                String
  competitionSeason   CompetitionSeason  @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  rounds              Round[]
  teamRegistrations   TeamRegistration[]
  games               Game[]
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@unique([competitionSeasonId, name])
  @@map("groups")
}

model Round {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  number    Int
  name      String?
  startsOn  DateTime? @map("starts_on") @db.Date
  endsOn    DateTime? @map("ends_on") @db.Date
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  games     Game[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([groupId, number])
  @@map("rounds")
}

model Team {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  clubName      String?            @map("club_name")
  registrations TeamRegistration[]
  homeGames     Game[]             @relation("HomeTeam")
  awayGames     Game[]             @relation("AwayTeam")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([name])
  @@map("teams")
}

model TeamRegistration {
  id                  String               @id @default(uuid()) @db.Uuid
  teamId              String               @map("team_id") @db.Uuid
  competitionSeasonId String               @map("competition_season_id") @db.Uuid
  groupId             String?              @map("group_id") @db.Uuid
  displayName         String?              @map("display_name")
  team                Team                 @relation(fields: [teamId], references: [id], onDelete: Restrict)
  competitionSeason   CompetitionSeason    @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  group               Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  playerRegistrations PlayerRegistration[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([teamId, competitionSeasonId])
  @@index([competitionSeasonId, groupId])
  @@map("team_registrations")
}

model Player {
  id            String                   @id @default(uuid()) @db.Uuid
  displayName   String                   @map("display_name")
  provisional   Boolean                  @default(false)
  registrations PlayerRegistration[]
  fantasyScores FantasyPlayerGameScore[]
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  @@index([displayName])
  @@map("players")
}

model PlayerRegistration {
  id                  String            @id @default(uuid()) @db.Uuid
  playerId            String            @map("player_id") @db.Uuid
  teamRegistrationId  String            @map("team_registration_id") @db.Uuid
  competitionSeasonId String            @map("competition_season_id") @db.Uuid
  shirtNumber         String?           @map("shirt_number")
  player              Player            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  teamRegistration    TeamRegistration  @relation(fields: [teamRegistrationId], references: [id], onDelete: Cascade)
  competitionSeason   CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  stats               PlayerGameStat[]
  fantasyRosterSlots  FantasyRosterSlot[]
  fantasyLineupSlots  FantasyLineupSlot[]
  prices              PlayerPrice[]
  priceEvents         PlayerPriceEvent[]
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@unique([playerId, teamRegistrationId])
  @@index([competitionSeasonId])
  @@map("player_registrations")
}

model FantasyRosterRuleSet {
  id                    String            @id @default(uuid()) @db.Uuid
  competitionSeasonId   String            @map("competition_season_id") @db.Uuid
  identifier            String
  version               String
  budgetCredits         BigInt            @map("budget_credits")
  rosterSize            Int               @map("roster_size")
  starterCount          Int               @map("starter_count")
  substituteCount       Int               @map("substitute_count")
  maxPerRealTeam        Int               @map("max_per_real_team")
  positionLimits        Json              @default("{}") @map("position_limits")
  coldStartPriceCredits BigInt            @map("cold_start_price_credits")
  status                String            @default("ACTIVE")
  competitionSeason     CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Restrict)
  fantasyTeams          FantasyTeam[]
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([competitionSeasonId, identifier, version])
  @@index([competitionSeasonId, status])
  @@map("fantasy_roster_rule_sets")
}

model FantasyTeam {
  id                    String               @id @default(uuid()) @db.Uuid
  userProfileId         String               @map("user_profile_id") @db.Uuid
  competitionSeasonId   String               @map("competition_season_id") @db.Uuid
  rosterRuleSetId       String               @map("roster_rule_set_id") @db.Uuid
  leagueId              String               @map("league_id") @db.Uuid
  version               Int                  @default(1)
  userProfile           UserProfile          @relation(fields: [userProfileId], references: [id], onDelete: Restrict)
  competitionSeason     CompetitionSeason    @relation(fields: [competitionSeasonId], references: [id], onDelete: Restrict)
  rosterRuleSet         FantasyRosterRuleSet @relation(fields: [rosterRuleSetId], references: [id], onDelete: Restrict)
  league                FantasyLeague        @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  rosterSlots           FantasyRosterSlot[]
  lineups               FantasyLineup[]
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userProfileId, leagueId])
  @@index([competitionSeasonId])
  @@map("fantasy_teams")
}

model FantasyLeague {
  id                  String             @id @default(uuid()) @db.Uuid
  competitionSeasonId String             @map("competition_season_id") @db.Uuid
  ownerProfileId      String             @map("owner_profile_id") @db.Uuid
  name                String
  status              String             @default("ACTIVE")
  memberLimit         Int                @default(20) @map("member_limit")
  version             Int                @default(1)
  legacyTeamId        String?            @unique @map("legacy_team_id") @db.Uuid
  competitionSeason   CompetitionSeason  @relation(fields: [competitionSeasonId], references: [id], onDelete: Restrict)
  ownerProfile        UserProfile        @relation("FantasyLeagueOwner", fields: [ownerProfileId], references: [id], onDelete: Restrict)
  memberships         LeagueMembership[]
  invites             LeagueInvite[]
  fantasyTeams        FantasyTeam[]
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([competitionSeasonId, status])
  @@index([ownerProfileId])
  @@map("fantasy_leagues")
}

model LeagueMembership {
  id            String        @id @default(uuid()) @db.Uuid
  leagueId      String        @map("league_id") @db.Uuid
  userProfileId String        @map("user_profile_id") @db.Uuid
  role          String        @default("MEMBER")
  status        String        @default("ACTIVE")
  league        FantasyLeague @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  userProfile   UserProfile   @relation(fields: [userProfileId], references: [id], onDelete: Restrict)
  joinedAt      DateTime      @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt        DateTime?     @map("left_at") @db.Timestamptz(3)

  @@unique([leagueId, userProfileId])
  @@index([userProfileId, status])
  @@map("league_memberships")
}

model LeagueInvite {
  id          String        @id @default(uuid()) @db.Uuid
  leagueId    String        @map("league_id") @db.Uuid
  tokenHash   String        @unique @map("token_hash") @db.Char(64)
  status      String        @default("ACTIVE")
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(3)
  league      FantasyLeague @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([leagueId, status])
  @@map("league_invites")
}

model FantasyRosterSlot {
  id                   String             @id @default(uuid()) @db.Uuid
  fantasyTeamId        String             @map("fantasy_team_id") @db.Uuid
  playerRegistrationId String             @map("player_registration_id") @db.Uuid
  acquisitionPrice     BigInt             @map("acquisition_price")
  fantasyTeam          FantasyTeam        @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  playerRegistration   PlayerRegistration @relation(fields: [playerRegistrationId], references: [id], onDelete: Restrict)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([fantasyTeamId, playerRegistrationId])
  @@map("fantasy_roster_slots")
}

model PlayerPrice {
  id                   String             @id @default(uuid()) @db.Uuid
  playerRegistrationId String             @map("player_registration_id") @db.Uuid
  competitionSeasonId  String             @map("competition_season_id") @db.Uuid
  algorithmVersion     String             @map("algorithm_version")
  currentPrice         BigInt             @map("current_price")
  status               String             @default("PROVISIONAL")
  lastRoundNumber      Int?               @map("last_round_number")
  allTimeHigh          BigInt             @map("all_time_high")
  allTimeLow           BigInt             @map("all_time_low")
  playerRegistration   PlayerRegistration @relation(fields: [playerRegistrationId], references: [id], onDelete: Restrict)
  competitionSeason    CompetitionSeason  @relation(fields: [competitionSeasonId], references: [id], onDelete: Restrict)
  events               PlayerPriceEvent[]
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([playerRegistrationId, competitionSeasonId, algorithmVersion])
  @@index([competitionSeasonId, algorithmVersion, currentPrice])
  @@map("player_prices")
}

model PlayerPriceEvent {
  id                   String             @id @default(uuid()) @db.Uuid
  playerPriceId        String             @map("player_price_id") @db.Uuid
  playerRegistrationId String             @map("player_registration_id") @db.Uuid
  competitionSeasonId  String             @map("competition_season_id") @db.Uuid
  roundNumber          Int                @map("round_number")
  algorithmVersion     String             @map("algorithm_version")
  inputRevision        String             @map("input_revision") @db.Char(64)
  status               String
  previousPrice        BigInt             @map("previous_price")
  targetPrice          BigInt?            @map("target_price")
  newPrice             BigInt             @map("new_price")
  recentForm           Decimal?           @map("recent_form") @db.Decimal(18, 6)
  seasonAverage        Decimal?           @map("season_average") @db.Decimal(18, 6)
  marketRating         Decimal?           @map("market_rating") @db.Decimal(18, 6)
  percentile           Decimal?           @db.Decimal(9, 6)
  dnpStreak            Int                @default(0) @map("dnp_streak")
  inputSnapshot        Json               @map("input_snapshot")
  playerPrice          PlayerPrice        @relation(fields: [playerPriceId], references: [id], onDelete: Restrict)
  playerRegistration   PlayerRegistration @relation(fields: [playerRegistrationId], references: [id], onDelete: Restrict)
  competitionSeason    CompetitionSeason  @relation(fields: [competitionSeasonId], references: [id], onDelete: Restrict)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([playerPriceId, roundNumber, algorithmVersion, inputRevision])
  @@index([competitionSeasonId, roundNumber, algorithmVersion])
  @@index([playerRegistrationId, createdAt])
  @@map("player_price_events")
}

model FantasyLineup {
  id              String              @id @default(uuid()) @db.Uuid
  fantasyTeamId   String              @map("fantasy_team_id") @db.Uuid
  roundNumber     Int                 @map("round_number")
  revision        Int
  status          String              @default("DRAFT")
  cutoffAt        DateTime            @map("cutoff_at") @db.Timestamptz(3)
  lockedAt        DateTime?           @map("locked_at") @db.Timestamptz(3)
  supersededAt    DateTime?           @map("superseded_at") @db.Timestamptz(3)
  fantasyTeam     FantasyTeam         @relation(fields: [fantasyTeamId], references: [id], onDelete: Restrict)
  slots           FantasyLineupSlot[]
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([fantasyTeamId, roundNumber, revision])
  @@index([fantasyTeamId, roundNumber, supersededAt])
  @@map("fantasy_lineups")
}

model FantasyLineupSlot {
  id                   String             @id @default(uuid()) @db.Uuid
  fantasyLineupId      String             @map("fantasy_lineup_id") @db.Uuid
  playerRegistrationId String             @map("player_registration_id") @db.Uuid
  role                 String
  ordinal              Int
  playerIdSnapshot     String             @map("player_id_snapshot") @db.Uuid
  displayNameSnapshot  String             @map("display_name_snapshot")
  realTeamIdSnapshot   String             @map("real_team_id_snapshot") @db.Uuid
  realTeamNameSnapshot String             @map("real_team_name_snapshot")
  acquisitionPrice     BigInt             @map("acquisition_price")
  marketPriceSnapshot  BigInt?            @map("market_price_snapshot")
  fantasyLineup        FantasyLineup      @relation(fields: [fantasyLineupId], references: [id], onDelete: Restrict)
  playerRegistration   PlayerRegistration @relation(fields: [playerRegistrationId], references: [id], onDelete: Restrict)

  @@unique([fantasyLineupId, playerRegistrationId])
  @@unique([fantasyLineupId, role, ordinal])
  @@map("fantasy_lineup_slots")
}

model Game {
  id                  String                   @id @default(uuid()) @db.Uuid
  competitionSeasonId String                   @map("competition_season_id") @db.Uuid
  groupId             String?                  @map("group_id") @db.Uuid
  roundId             String?                  @map("round_id") @db.Uuid
  homeTeamId          String                   @map("home_team_id") @db.Uuid
  awayTeamId          String                   @map("away_team_id") @db.Uuid
  scheduledAt         DateTime?                @map("scheduled_at") @db.Timestamptz(3)
  sourceTimezone      String?                  @map("source_timezone")
  roundNumber         Int?                     @map("round_number")
  status              String
  sourceStatus        String?                  @map("source_status")
  homeScore           Int?                     @map("home_score")
  awayScore           Int?                     @map("away_score")
  scoreByPeriod       Json?                    @map("score_by_period")
  sourceScore         Json?                    @map("source_score")
  recordType          String?                  @map("record_type")
  hasStatistics       Boolean                  @default(false) @map("has_statistics")
  sourceUpdatedAt     DateTime?                @map("source_updated_at") @db.Timestamptz(3)
  lastSeenAt          DateTime                 @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  syncStatus          String                   @default("active") @map("sync_status")
  statsSyncStatus     String                   @default("pending") @map("stats_sync_status")
  statsSyncedAt       DateTime?                @map("stats_synced_at") @db.Timestamptz(3)
  competitionSeason   CompetitionSeason        @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  group               Group?                   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  round               Round?                   @relation(fields: [roundId], references: [id], onDelete: SetNull)
  homeTeam            Team                     @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam            Team                     @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  playerStats         PlayerGameStat[]
  fantasyScores       FantasyPlayerGameScore[]
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@index([competitionSeasonId, roundNumber])
  @@index([competitionSeasonId, syncStatus])
  @@index([scheduledAt])
  @@map("games")
}

model PlayerGameStat {
  id                     String                   @id @default(uuid()) @db.Uuid
  gameId                 String                   @map("game_id") @db.Uuid
  playerRegistrationId   String                   @map("player_registration_id") @db.Uuid
  starter                Boolean?
  minutesPlayed          Decimal?                 @map("minutes_played") @db.Decimal(8, 3)
  millisecondsPlayed     Int?                     @map("milliseconds_played")
  points                 Int?
  freeThrowsMade         Int?                     @map("free_throws_made")
  freeThrowsAttempted    Int?                     @map("free_throws_attempted")
  twoPointersMade        Int?                     @map("two_pointers_made")
  twoPointersAttempted   Int?                     @map("two_pointers_attempted")
  threePointersMade      Int?                     @map("three_pointers_made")
  threePointersAttempted Int?                     @map("three_pointers_attempted")
  offensiveRebounds      Int?                     @map("offensive_rebounds")
  defensiveRebounds      Int?                     @map("defensive_rebounds")
  rebounds               Int?
  assists                Int?
  steals                 Int?
  turnovers              Int?
  blocks                 Int?
  blocksReceived         Int?                     @map("blocks_received")
  foulsCommitted         Int?                     @map("fouls_committed")
  foulsReceived          Int?                     @map("fouls_received")
  technicalFouls         Int?                     @map("technical_fouls")
  valuation              Int?
  plusMinus              Int?                     @map("plus_minus")
  game                   Game                     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerRegistration     PlayerRegistration       @relation(fields: [playerRegistrationId], references: [id], onDelete: Cascade)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  fantasyScores          FantasyPlayerGameScore[]

  @@unique([gameId, playerRegistrationId])
  @@map("player_game_stats")
}

model FantasyScoringRuleSet {
  id                  String                     @id @default(uuid()) @db.Uuid
  competitionSeasonId String                     @map("competition_season_id") @db.Uuid
  identifier          String
  version             String
  calculationType     String                     @map("calculation_type")
  status              String                     @default("DRAFT")
  definition          Json
  publishedAt         DateTime?                  @map("published_at") @db.Timestamptz(3)
  retiredAt           DateTime?                  @map("retired_at") @db.Timestamptz(3)
  competitionSeason   CompetitionSeason          @relation(fields: [competitionSeasonId], references: [id], onDelete: Restrict)
  scores              FantasyPlayerGameScore[]
  activationEvents    FantasyRuleSetActivation[]
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([competitionSeasonId, calculationType, identifier, version])
  @@index([competitionSeasonId, calculationType, status])
  @@map("fantasy_scoring_rule_sets")
}

model FantasyPlayerGameScore {
  id                      String                @id @default(uuid()) @db.Uuid
  playerGameStatId        String                @map("player_game_stat_id") @db.Uuid
  playerId                String                @map("player_id") @db.Uuid
  gameId                  String                @map("game_id") @db.Uuid
  ruleSetId               String                @map("rule_set_id") @db.Uuid
  ruleSetVersion          String                @map("rule_set_version")
  sourceStatsVersion      String                @map("source_stats_version") @db.Char(64)
  rawScore                Decimal?              @map("raw_score") @db.Decimal(18, 6)
  normalizedFantasyPoints Decimal?              @map("normalized_fantasy_points") @db.Decimal(18, 6)
  status                  String
  errorCode               String?               @map("error_code")
  breakdown               Json
  playerGameStat          PlayerGameStat        @relation(fields: [playerGameStatId], references: [id], onDelete: Restrict)
  player                  Player                @relation(fields: [playerId], references: [id], onDelete: Restrict)
  game                    Game                  @relation(fields: [gameId], references: [id], onDelete: Restrict)
  ruleSet                 FantasyScoringRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([playerGameStatId, ruleSetId, sourceStatsVersion])
  @@index([playerId, gameId, ruleSetId])
  @@map("fantasy_player_game_scores")
}

model FantasyRuleSetActivation {
  id                  String                @id @default(uuid()) @db.Uuid
  competitionSeasonId String                @map("competition_season_id") @db.Uuid
  ruleSetId           String                @map("rule_set_id") @db.Uuid
  action              String
  actor               String
  reason              String
  occurredAt          DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(3)
  competitionSeason   CompetitionSeason     @relation(fields: [competitionSeasonId], references: [id], onDelete: Restrict)
  ruleSet             FantasyScoringRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)

  @@index([competitionSeasonId, occurredAt])
  @@map("fantasy_rule_set_activations")
}

model ExternalId {
  id         String   @id @default(uuid()) @db.Uuid
  source     String
  entityType String   @map("entity_type")
  externalId String   @map("external_id")
  entityId   String   @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([source, entityType, externalId])
  @@index([source, entityType, entityId])
  @@map("external_ids")
}

model RawFabPayload {
  id          String   @id @default(uuid()) @db.Uuid
  endpoint    String
  entityType  String   @map("entity_type")
  externalId  String?  @map("external_id")
  retrievedAt DateTime @default(now()) @map("retrieved_at") @db.Timestamptz(3)
  httpStatus  Int      @map("http_status")
  checksum    String
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([endpoint, checksum])
  @@index([entityType, externalId, retrievedAt])
  @@map("raw_fab_payloads")
}

model IngestionRun {
  id                  String             @id @default(uuid()) @db.Uuid
  jobName             String             @map("job_name")
  competitionSeasonId String?            @map("competition_season_id") @db.Uuid
  startedAt           DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt          DateTime?          @map("finished_at") @db.Timestamptz(3)
  status              String
  counters            Json?
  errorCode           String?            @map("error_code")
  competitionSeason   CompetitionSeason? @relation(fields: [competitionSeasonId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now()) @map("created_at")

  @@index([jobName, startedAt])
  @@index([competitionSeasonId, startedAt])
  @@map("ingestion_runs")
}
