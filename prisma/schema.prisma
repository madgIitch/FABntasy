generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model UserProfile {
  id                      String                   @id @default(uuid()) @db.Uuid
  authUserId              String                   @unique @map("auth_user_id") @db.Uuid
  username                String?                  @unique @db.VarChar(24)
  displayName             String?                  @map("display_name")
  avatarPath              String?                  @map("avatar_path")
  discoverableByUsername  Boolean                  @default(true) @map("discoverable_by_username")
  deletedAt               DateTime?                @map("deleted_at") @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  fantasyTeams            FantasyTeam[]
  ownedFantasyLeagues     FantasyLeague[]          @relation("FantasyLeagueOwner")
  leagueMemberships       LeagueMembership[]
  pushSubscriptions       PushSubscription[]
  notificationPreferences NotificationPreference[]
  notificationDeliveries  NotificationDelivery[]
  pushOutboxEvents        PushOutboxEvent[]
  adminGrants             AdminGrant[]             @relation("AdminGrantProfile")
  grantedAdminGrants      AdminGrant[]             @relation("AdminGrantGrantedBy")
  ingestionJobsRequested  IngestionJob[]
  adminAuditEvents        AdminAuditEvent[]
  sportsDataRevisions     SportsDataRevision[]     @relation("SportsDataRevisionActor")
  feedback                UserFeedback[]

  @@map("user_profiles")
}

model UserFeedback {
  id                      String      @id @default(uuid()) @db.Uuid
  userProfileId           String      @map("user_profile_id") @db.Uuid
  category                String      @db.VarChar(32)
  text                    String      @db.VarChar(1000)
  status                  String      @default("NEW") @db.VarChar(24)
  technicalContext        Json?       @map("technical_context")
  technicalContextConsent Boolean     @default(false) @map("technical_context_consent")
  idempotencyKey          String      @map("idempotency_key") @db.VarChar(128)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  userProfile             UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, idempotencyKey])
  @@index([status, createdAt])
  @@map("user_feedback")
}

model PushSubscription {
  id            String                 @id @default(uuid()) @db.Uuid
  userProfileId String                 @map("user_profile_id") @db.Uuid
  endpoint      String                 @unique @db.Text
  p256dh        String                 @db.Text
  auth          String                 @db.Text
  vapidKeyVersion String?              @map("vapid_key_version") @db.VarChar(32)
  deviceId      String?                @map("device_id") @db.Uuid
  userAgent     String?                @map("user_agent") @db.VarChar(512)
  lastSeenAt    DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt     DateTime?              @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?                @map("revoked_reason") @db.VarChar(24)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  userProfile   UserProfile            @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  deliveries    NotificationDelivery[]

  @@index([userProfileId, revokedAt])
  @@map("push_subscriptions")
}

model NotificationPreference {
  id            String      @id @default(uuid()) @db.Uuid
  userProfileId String      @map("user_profile_id") @db.Uuid
  intent        String      @db.VarChar(32)
  enabled       Boolean     @default(false)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, intent])
  @@map("notification_preferences")
}

model NotificationDelivery {
  id                 String           @id @default(uuid()) @db.Uuid
  userProfileId      String           @map("user_profile_id") @db.Uuid
  pushSubscriptionId String           @map("push_subscription_id") @db.Uuid
  intent             String           @db.VarChar(32)
  eventKey           String           @map("event_key") @db.VarChar(191)
  status             String           @db.VarChar(24)
  attemptCount       Int              @default(0) @map("attempt_count")
  lastErrorCode      String?          @map("last_error_code") @db.VarChar(64)
  deliveredAt        DateTime?        @map("delivered_at") @db.Timestamptz(3)
  nextAttemptAt      DateTime         @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimedAt          DateTime?        @map("claimed_at") @db.Timestamptz(3)
  claimToken         String?          @map("claim_token") @db.Uuid
  lastAttemptAt      DateTime?        @map("last_attempt_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  userProfile        UserProfile      @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  pushSubscription   PushSubscription @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)

  @@unique([pushSubscriptionId, intent, eventKey])
  @@index([userProfileId, status, createdAt])
  @@index([status, nextAttemptAt, claimedAt])
  @@map("notification_deliveries")
}

model PushOutboxEvent {
  id            String      @id @default(uuid()) @db.Uuid
  userProfileId String      @map("user_profile_id") @db.Uuid
  eventKey      String      @unique @map("event_key") @db.VarChar(191)
  payload       Json
  status        String      @default("PENDING") @db.VarChar(24)
  attemptCount  Int         @default(0) @map("attempt_count")
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimedAt     DateTime?   @map("claimed_at") @db.Timestamptz(3)
  lastErrorCode String?     @map("last_error_code") @db.VarChar(64)
  deliveredAt  DateTime?   @map("delivered_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, claimedAt])
  @@map("push_outbox_events")
}

model Federation {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  countryCode  String        @default("ES") @map("country_code")
  competitions Competition[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([name, countryCode])
  @@map("federations")
}

model Competition {
  id                 String              @id @default(uuid()) @db.Uuid
  federationId       String              @map("federation_id") @db.Uuid
  name               String
  federation         Federation          @relation(fields: [federationId], references: [id], onDelete: Restrict)
  competitionSeasons CompetitionSeason[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@unique([federationId, name])
  @@map("competitions")
}

model Season {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @unique
  startsOn           DateTime?           @map("starts_on") @db.Date
  endsOn             DateTime?           @map("ends_on") @db.Date
  competitionSeasons CompetitionSeason[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("seasons")
}

model CompetitionSeason {
  id                    String                     @id @default(uuid()) @db.Uuid
  competitionId         String                     @map("competition_id") @db.Uuid
  seasonId              String                     @map("season_id") @db.Uuid
  name                  String?
  fantasyEnabled        Boolean                    @default(false) @map("fantasy_enabled")
  fantasyRole           String                     @default("disabled") @map("fantasy_role")
  categoryName          String?                    @map("category_name")
  delegationName        String?                    @map("delegation_name")
  competition           Competition                @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  season                Season                     @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  groups                Group[]
  teamRegistrations     TeamRegistration[]
  playerRegistrations   PlayerRegistration[]
  games                 Game[]
  ingestionRuns         IngestionRun[]
  fantasyRuleSets       FantasyScoringRuleSet[]
  fantasyRuleSetEvents  FantasyRuleSetActivation[]
  fantasyRosterRuleSets FantasyRosterRuleSet[]
  fantasyTeams          FantasyTeam[]
  playerPrices          PlayerPrice[]
  playerPriceEvents     PlayerPriceEvent[]
  fantasyLeagues        FantasyLeague[]
  fantasyRoundScores    FantasyRoundScore[]
  fabCatalogEntries     FabCompetitionCatalog[]
  fantasyTeamTotals     FantasyTeamTotal[]
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")

  @@unique([competitionId, seasonId])
  @@map("competition_seasons")
}

model FabCompetitionCatalog {
  id                    String                        @id @default(uuid()) @db.Uuid
  opaqueId              String                        @unique @map("opaque_id") @db.VarChar(191)
  categoryCompetitionId String                        @map("category_competition_id") @db.VarChar(191)
  categoryName          String                        @map("category_name")
  competitionName       String                        @map("competition_name")
  delegationName        String                        @map("delegation_name")
  seasonName            String?                       @map("season_name")
  alias                 String?
  monitored             Boolean                       @default(false)
  status                String                        @default("DISCOVERED") @db.VarChar(24)
  checksum              String                        @db.Char(64)
  competitionSeasonId   String?                       @map("competition_season_id") @db.Uuid
  competitionSeason     CompetitionSeason?            @relation(fields: [competitionSeasonId], references: [id], onDelete: SetNull)
  firstSeenAt           DateTime                      @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastCheckedAt         DateTime                      @default(now()) @map("last_checked_at") @db.Timestamptz(3)
  lastChangedAt         DateTime                      @default(now()) @map("last_changed_at") @db.Timestamptz(3)
  changes               FabCompetitionCatalogChange[]

  @@index([categoryCompetitionId])
  @@index([monitored, lastCheckedAt])
  @@index([delegationName, competitionName])
  @@map("fab_competition_catalog")
}

model FabCompetitionCatalogChange {
  id        String                @id @default(uuid()) @db.Uuid
  catalogId String                @map("catalog_id") @db.Uuid
  checksum  String                @db.Char(64)
  before    Json?
  after     Json
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  catalog   FabCompetitionCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@unique([catalogId, checksum])
  @@index([createdAt])
  @@map("fab_competition_catalog_changes")
}

model FabCompetitionCatalogScan {
  id         String    @id @default(uuid()) @db.Uuid
  status     String    @default("RUNNING") @db.VarChar(24)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  pages      Int       @default(0)
  observed   Int       @default(0)
  discovered Int       @default(0)
  changed    Int       @default(0)
  errorCode  String?   @map("error_code") @db.VarChar(64)

  @@index([startedAt])
  @@map("fab_competition_catalog_scans")
}

model Group {
  id                  String             @id @default(uuid()) @db.Uuid
  competitionSeasonId String             @map("competition_season_id") @db.Uuid
  name                String
  competitionSeason   CompetitionSeason  @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  rounds              Round[]
  teamRegistrations   TeamRegistration[]
  games               Game[]
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@unique([competitionSeasonId, name])
  @@map("groups")
}

model Round {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  number    Int
  name      String?
  startsOn  DateTime? @map("starts_on") @db.Date
  endsOn    DateTime? @map("ends_on") @db.Date
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  games     Game[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([groupId, number])
  @@map("rounds")
}

model Team {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  clubName      String?            @map("club_name")
  registrations TeamRegistration[]
  homeGames     Game[]             @relation("HomeTeam")
  awayGames     Game[]             @relation("AwayTeam")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([name])
  @@map("teams")
}

model TeamRegistration {
  id                  String               @id @default(uuid()) @db.Uuid
  teamId              String               @map("team_id") @db.Uuid
  competitionSeasonId String               @map("competition_season_id") @db.Uuid
  groupId             String?              @map("group_id") @db.Uuid
  displayName         String?              @map("display_name")
  team                Team                 @relation(fields: [teamId], references: [id], onDelete: Restrict)
  competitionSeason   CompetitionSeason    @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  group               Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  playerRegistrations PlayerRegistration[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([teamId, competitionSeasonId])
  @@index([competitionSeasonId, groupId])
  @@map("team_registrations")
}

model Player {
  id            String                   @id @default(uuid()) @db.Uuid
  displayName   String                   @map("display_name")
  provisional   Boolean                  @default(false)
  registrations PlayerRegistration[]
  fantasyScores FantasyPlayerGameScore[]
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  @@index([displayName])
  @@map("players")
}

model PlayerRegistration {
  id                  String              @id @default(uuid()) @db.Uuid
  playerId            String              @map("player_id") @db.Uuid
  teamRegistrationId  String              @map("team_registration_id") @db.Uuid
  competitionSeasonId String              @map("competition_season_id") @db.Uuid
  shirtNumber         String?             @map("shirt_number")
  player              Player              @relation(fields: [playerId], references: [id], onDelete: Restrict)
  teamRegistration    TeamRegistration    @relation(fields: [teamRegistrationId], references: [id], onDelete: Cascade)
  competitionSeason   CompetitionSeason   @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  stats               PlayerGameStat[]
  fantasyRosterSlots  FantasyRosterSlot[]
  fantasyLineupSlots  FantasyLineupSlot[]
  prices              PlayerPrice[]
  priceEvents         PlayerPriceEvent[]
  marketTransactions  MarketTransaction[]
  marketProtections   MarketProtection[]
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@unique([playerId, teamRegistrationId])
  @@index([competitionSeasonId])
  @@map("player_registrations")
}

model FantasyRosterRuleSet {
  id                    String            @id @default(uuid()) @db.Uuid
  competitionSeasonId   String            @map("competition_season_id") @db.Uuid
  identifier            String
  version               String
  budgetCredits         BigInt            @map("budget_credits")
  rosterSize            Int               @map("roster_size")
  starterCount          Int               @map("starter_count")
  substituteCount       Int               @map("substitute_count")
  maxPerRealTeam        Int               @map("max_per_real_team")
  positionLimits        Json              @default("{}") @map("position_limits")
  coldStartPriceCredits BigInt            @map("cold_start_price_credits")
  status                String            @default("ACTIVE")
  competitionSeason     CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Restrict)
  fantasyTeams          FantasyTeam[]
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([competitionSeasonId, identifier, version])
  @@index([competitionSeasonId, status])
  @@map("fantasy_roster_rule_sets")
}

model FantasyTeam {
  id                  String                     @id @default(uuid()) @db.Uuid
  name                String                     @default("Mi equipo") @db.VarChar(60)
  userProfileId       String                     @map("user_profile_id") @db.Uuid
  competitionSeasonId String                     @map("competition_season_id") @db.Uuid
  rosterRuleSetId     String                     @map("roster_rule_set_id") @db.Uuid
  leagueId            String                     @map("league_id") @db.Uuid
  version             Int                        @default(1)
  balanceCredits      BigInt?                    @map("balance_credits")
  userProfile         UserProfile                @relation(fields: [userProfileId], references: [id], onDelete: Restrict)
  competitionSeason   CompetitionSeason          @relation(fields: [competitionSeasonId], references: [id], onDelete: Restrict)
  rosterRuleSet       FantasyRosterRuleSet       @relation(fields: [rosterRuleSetId], references: [id], onDelete: Restrict)
  league              FantasyLeague              @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  rosterSlots         FantasyRosterSlot[]
  lineups             FantasyLineup[]
  budgetLedger        FantasyBudgetLedgerEntry[]
  purchases           MarketTransaction[]        @relation("MarketBuyer")
  sales               MarketTransaction[]        @relation("MarketSeller")
  marketProtections   MarketProtection[]
  roundScores         FantasyRoundScore[]
  total               FantasyTeamTotal?
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userProfileId, leagueId])
  @@index([competitionSeasonId])
  @@map("fantasy_teams")
}

model FantasyLeague {
  id                  String                     @id @default(uuid()) @db.Uuid
  competitionSeasonId String                     @map("competition_season_id") @db.Uuid
  ownerProfileId      String                     @map("owner_profile_id") @db.Uuid
  name                String
  leagueCode          String                     @unique @map("league_code") @db.VarChar(12)
  passwordHash        String?                    @map("password_hash") @db.VarChar(255)
  status              String                     @default("ACTIVE")
  memberLimit         Int                        @default(20) @map("member_limit")
  version             Int                        @default(1)
  legacyTeamId        String?                    @unique @map("legacy_team_id") @db.Uuid
  competitionSeason   CompetitionSeason          @relation(fields: [competitionSeasonId], references: [id], onDelete: Restrict)
  ownerProfile        UserProfile                @relation("FantasyLeagueOwner", fields: [ownerProfileId], references: [id], onDelete: Restrict)
  memberships         LeagueMembership[]
  invites             LeagueInvite[]
  fantasyTeams        FantasyTeam[]
  marketTransactions  MarketTransaction[]
  budgetLedger        FantasyBudgetLedgerEntry[]
  marketProtections   MarketProtection[]
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  fantasyRosterSlots  FantasyRosterSlot[]
  roundScores         FantasyRoundScore[]
  teamTotals          FantasyTeamTotal[]

  @@index([competitionSeasonId, status])
  @@index([ownerProfileId])
  @@map("fantasy_leagues")
}

model LeagueMembership {
  id            String        @id @default(uuid()) @db.Uuid
  leagueId      String        @map("league_id") @db.Uuid
  userProfileId String        @map("user_profile_id") @db.Uuid
  role          String        @default("MEMBER")
  status        String        @default("ACTIVE")
  league        FantasyLeague @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  userProfile   UserProfile   @relation(fields: [userProfileId], references: [id], onDelete: Restrict)
  joinedAt      DateTime      @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt        DateTime?     @map("left_at") @db.Timestamptz(3)

  @@unique([leagueId, userProfileId])
  @@index([userProfileId, status])
  @@map("league_memberships")
}

model LeagueInvite {
  id        String        @id @default(uuid()) @db.Uuid
  leagueId  String        @map("league_id") @db.Uuid
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  status    String        @default("ACTIVE")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime?     @map("revoked_at") @db.Timestamptz(3)
  league    FantasyLeague @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([leagueId, status])
  @@map("league_invites")
}

model FantasyRosterSlot {
  id                   String             @id @default(uuid()) @db.Uuid
  fantasyTeamId        String             @map("fantasy_team_id") @db.Uuid
  leagueId             String             @map("league_id") @db.Uuid
  playerRegistrationId String             @map("player_registration_id") @db.Uuid
  acquisitionPrice     BigInt             @map("acquisition_price")
  fantasyTeam          FantasyTeam        @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  playerRegistration   PlayerRegistration @relation(fields: [playerRegistrationId], references: [id], onDelete: Restrict)
  league               FantasyLeague      @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  clauseInvestment     ClauseInvestment?
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([fantasyTeamId, playerRegistrationId])
  @@unique([leagueId, playerRegistrationId])
  @@index([leagueId])
  @@map("fantasy_roster_slots")
}

model FantasyBudgetLedgerEntry {
  id            String             @id @default(uuid()) @db.Uuid
  fantasyTeamId String             @map("fantasy_team_id") @db.Uuid
  leagueId      String             @map("league_id") @db.Uuid
  transactionId String?            @map("transaction_id") @db.Uuid
  entryType     String             @map("entry_type")
  amountCredits BigInt             @map("amount_credits")
  balanceAfter  BigInt             @map("balance_after")
  fantasyTeam   FantasyTeam        @relation(fields: [fantasyTeamId], references: [id], onDelete: Restrict)
  league        FantasyLeague      @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  transaction   MarketTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([fantasyTeamId, createdAt])
  @@index([leagueId, createdAt])
  @@map("fantasy_budget_ledger")
}

model MarketTransaction {
  id                      String                     @id @default(uuid()) @db.Uuid
  leagueId                String                     @map("league_id") @db.Uuid
  playerRegistrationId    String                     @map("player_registration_id") @db.Uuid
  buyerTeamId             String?                    @map("buyer_team_id") @db.Uuid
  sellerTeamId            String?                    @map("seller_team_id") @db.Uuid
  transactionType         String                     @map("transaction_type")
  priceCredits            BigInt                     @map("price_credits")
  marketPriceCredits      BigInt                     @map("market_price_credits")
  clauseBaseCredits       BigInt?                    @map("clause_base_credits")
  clauseInvestmentCredits BigInt?                    @map("clause_investment_credits")
  roundNumber             Int?                       @map("round_number")
  idempotencyKey          String                     @unique @map("idempotency_key")
  league                  FantasyLeague              @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  playerRegistration      PlayerRegistration         @relation(fields: [playerRegistrationId], references: [id], onDelete: Restrict)
  buyerTeam               FantasyTeam?               @relation("MarketBuyer", fields: [buyerTeamId], references: [id], onDelete: Restrict)
  sellerTeam              FantasyTeam?               @relation("MarketSeller", fields: [sellerTeamId], references: [id], onDelete: Restrict)
  ledgerEntries           FantasyBudgetLedgerEntry[]
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([leagueId, createdAt])
  @@index([playerRegistrationId, leagueId])
  @@map("market_transactions")
}

model ClauseInvestment {
  id                  String            @id @default(uuid()) @db.Uuid
  fantasyRosterSlotId String            @unique @map("fantasy_roster_slot_id") @db.Uuid
  spentCredits        BigInt            @default(0) @map("spent_credits")
  clauseBonusCredits  BigInt            @default(0) @map("clause_bonus_credits")
